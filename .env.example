# Nivara — Client Environment Variables for Vercel Deployment
# In Vercel Project Settings > Environment Variables, configure the following:

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable Public Key (safe for browser client)
VITE_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here

# NOTE: Direct database credentials (DATABASE_URL, SUPABASE_SERVICE_ROLE_KEY)
# are only needed for backend administration scripts and should NEVER be exposed in client bundles.
